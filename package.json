{
  "name": "palace-omp",
  "version": "0.2.0",
  "description": "cmux와 native OMP를 중심으로 개발·동기화·자동화를 관리하는 macOS 데스크톱 control plane",
  "main": "./out/main/index.js",
  "author": "Godsenal",
  "license": "MIT",
  "private": true,
  "build": {
    "extends": "./electron-builder.config.cjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "service": "node out/main/automation-service.js",
    "companion:build": "node scripts/build-companion.mjs",
    "companion": "node out/companion-server/companion-service.cjs",
    "companion:pair": "node out/companion-server/companion-service.cjs pair",
    "companion:rotate-token": "node out/companion-server/companion-service.cjs rotate-token",
    "companion:install": "node scripts/companion-launchd.mjs install",
    "companion:uninstall": "node scripts/companion-launchd.mjs uninstall",
    "companion:status": "node scripts/companion-launchd.mjs status",
    "companion:test": "npm run companion:build && node --test scripts/companion.test.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test engines/loops/test/*.test.mjs",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs",
    "release": "npm run dist:mac"
  },
  "dependencies": {
    "cron-parser": "^5.10.1",
    "dompurify": "^3.1.7",
    "electron-updater": "^6.3.9",
    "marked": "^14.1.3",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
